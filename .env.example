# ============================================================
# Nexora-AI / AgentForge Environment Configuration
# ============================================================

# 1. Groq API Key (Required for LLM Orchestration)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override default model
GROQ_MODEL=openai/gpt-oss-20b

# 2. Tavily API Key (Required for Research Agent Web Search)
# Obtain from: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# 3. Mistral AI API Key (Required for RAG Agent Document Embeddings)
# Obtain from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
